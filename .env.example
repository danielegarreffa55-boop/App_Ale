# Branding (safe to expose in the client bundle)
STUDIO_NAME=Atelier Studio
APP_NAME=Atelier
SUPPORT_EMAIL=assistenza@example.it
SUPPORT_PHONE=+390000000000
ADDRESS=Via da definire, Italia
TIMEZONE=Europe/Rome
CURRENCY=EUR
REMINDER_TIME=18:00

# Firebase client configuration. Pass these with --dart-define-from-file.
FIREBASE_API_KEY=
FIREBASE_APP_ID_ANDROID=
FIREBASE_APP_ID_IOS=
FIREBASE_APP_ID_WEB=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MEASUREMENT_ID=
RECAPTCHA_V3_SITE_KEY=
FCM_WEB_VAPID_KEY=
USE_FIREBASE_EMULATORS=false
FIREBASE_EMULATOR_HOST=localhost

# Backend parameter (configure through Firebase/Google Cloud, never in app)
GOOGLE_CALENDAR_ID=
