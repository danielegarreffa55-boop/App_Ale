# FastAPI runtime. Never copy production secrets into a client JSON file.
APP_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=alessio_garreffa_hair
MONGODB_TRANSACTIONS=false
JWT_SECRET=development-only-change-this-jwt-secret-before-production
JWT_ISSUER=alessio-garreffa-hair-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PUBLIC_APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
EXPOSE_DEV_TOKENS=true

# Push provider. ONESIGNAL_API_KEY is backend-only.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Reminder endpoint: local shared secret or production Cloud Scheduler OIDC.
CRON_SECRET=development-cron-secret
CRON_OIDC_AUDIENCE=
CRON_SERVICE_ACCOUNT=

# Transactional email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true



# Optional dedicated business calendar.
GOOGLE_CALENDAR_ID=
APP_TIMEZONE=Europe/Rome
