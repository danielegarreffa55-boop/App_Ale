{
  "name": "salon-booking-workspace",
  "private": true,
  "scripts": {
    "setup:functions": "npm --prefix functions install",
    "emulators": "npm --prefix functions run build && firebase emulators:start --project salon-booking-demo",
    "seed": "npm --prefix functions run seed",
    "api:run": "backend\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir backend --reload --port 8088",
    "api:test": "backend\\.venv\\Scripts\\python.exe -m pytest backend\\tests -q",
    "configure:web-fcm": "node tool/generate-fcm-worker.mjs config/dev.json",
    "test:backend": "npm --prefix functions test",
    "build:functions": "npm --prefix functions run build"
  }
}
